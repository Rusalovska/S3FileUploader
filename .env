# .env

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://postgres:28302007@localhost:5432/filestore?schema=public"
DATABASE_POOL_MAX=10

# --- Storage (MinIO locally, swap to real S3 values in prod) ---
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=file-storage-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=900

# --- Auth ---
JWT_SECRET=dev-only-secret-change-this-to-a-real-32-char-value
JWT_EXPIRY=1h

# --- Cleanup job ---
CLEANUP_CRON_SCHEDULE="0 * * * *"
SOFT_DELETE_GRACE_DAYS=30

# --- Thumbnails ---
THUMBNAIL_SIZES=200,800